{
  "manifest_version": 3,
  "name": "Expert Hospice Audit Assistant",
  "version": "0.1.0",
  "description": "Generates hospice chart-audit prompts, parses Claude for Chrome results, and submits them to the ATTAbot! audit console.",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "host_permissions": ["https://ywwdgwiqoeqixmbvibeq.supabase.co/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Expert Hospice Audit Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
